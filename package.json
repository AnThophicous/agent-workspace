{
  "name": "@paper-workspace/paper-workspace",
  "version": "0.1.0",
  "description": "A local-first Paper workspace shared by people and AI agents through MCP.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "paper-workspace": "./dist/server/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "skill",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,app -c white,gray \"npm:dev:server\" \"npm:dev:app\"",
    "dev:server": "tsx watch src/server/cli.ts app --workspace ./examples/workspace --token dev --no-open",
    "dev:app": "vite --host 127.0.0.1 --port 43128",
    "build": "npm run build:server && npm run build:app",
    "build:server": "tsc -p tsconfig.server.json",
    "build:app": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm run typecheck && npm run build && node scripts/smoke-test.mjs",
    "start": "node dist/server/cli.js app",
    "mcp": "node dist/server/cli.js mcp",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server/cli.js mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@untitledui/icons": "^0.0.22",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "open": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  }
}
